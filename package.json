{
  "name": "corner-todo",
  "version": "0.2.0",
  "description": "목표·할 일·루틴 관리와 집중 타이머, 화면 구석 오버레이",
  "main": "src/main/index.js",
  "author": "ImGdevel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImGdevel/Todo.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke": "node tools/run-smoke.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "app.cornertodo.desktop",
    "productName": "Corner Todo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "koffi": "3.3.6"
  }
}
